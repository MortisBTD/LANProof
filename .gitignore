## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.cache
*.dbmdl
*.jfm

# Rider files
.idea/
*.sln.iml

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
**/packages/repositories.config
project.lock.json
project.fragment.lock.json
artifacts/

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# SQLite databases (user data, not committed)
*.db
*.db-shm
*.db-wal

# Publish output
publish/
work/
data/
tools/node_modules/
.avalonia-build-tasks/
**/.gradle/
**/.kotlin/
**/build/
**/local.properties
*.jks
*.keystore
